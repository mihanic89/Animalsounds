<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка "следующее задание" во всех играх: отдельный акцентный цвет, чтобы не сливаться
     с зелёным (правильно) / красным (неправильно) / другими элементами управления. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
    android:layout_width="15dp"
    android:layout_height="15dp">
    <corners android:radius="1000dp" />
    <solid android:color="#F5A623" />
    <stroke
        android:width="2dip"
        android:color="#D98A00" />
    <padding
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp" />
</shape>
