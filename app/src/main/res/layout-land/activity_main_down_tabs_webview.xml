<?xml version="1.0" encoding="utf-8"?>
<!-- Ландшафт: баннер и вкладки стоят в одной строке внизу — баннер слева, вкладки правее.
     Пока баннер не загрузился, MainActivity.setAdViewExpanded() схлопывает AdView до 0x0,
     и вкладки (toEndOf) занимают всю ширину, как в портрете. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="Image"
        android:gravity="center_horizontal" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/adView"
        android:theme="@style/AppTheme.AppBarOverlay"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabIndicatorHeight="0dp"
            app:tabRippleColor="@null"
            android:clipChildren="false"
            android:clipToPadding="false" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/appbarlayout" />

    <!-- Фиксированный размер BANNER (320x50): SMART_BANNER в ландшафте растягивается на всю
         ширину и не оставил бы места для вкладок. Ширина/высота/видимость задаются
         программно в MainActivity (setAdViewExpanded). Нижний отступ центрирует баннер
         относительно строки вкладок высотой 64dp. -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="7dp"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-2888343178529026/7953669395">
    </com.google.android.gms.ads.AdView>
</RelativeLayout>
