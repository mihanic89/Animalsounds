<?xml version="1.0" encoding="utf-8"?>
<!-- Портрет: сверху поле пазла (картинка сверху, лоток снизу; всё
     рисует PuzzleView), внизу строка управления. Ландшафтный вариант — в layout-land, id те же. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/puzzleControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/puzzleCounter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/oval_shape"
            android:clickable="false"
            android:elevation="5dp"
            android:focusable="false"
            android:minWidth="56dp"
            android:padding="1dp"
            android:textColor="#ffffff"
            android:textSize="22sp"
            app:autoSizeTextType="uniform"
            tools:text="10" />

        <ImageView
            android:id="@+id/sizeSmall"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/memory_size_chip"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_puzzle_size_large"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/sizeLarge"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/memory_size_chip"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_puzzle_size_medium"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/sizeExtra"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/memory_size_chip"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_puzzle_size_small"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/puzzleHint"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/oval_shape"
            android:elevation="5dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_puzzle_outline" />

        <ImageButton
            android:id="@+id/puzzleNext"
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/oval_shape_amber"
            android:elevation="5dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            app:srcCompat="@android:drawable/ic_media_next" />
    </LinearLayout>

    <com.yamilab.animalsounds.PuzzleView
        android:id="@+id/puzzleView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/puzzleControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
