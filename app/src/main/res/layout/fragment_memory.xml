<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Счётчик собранных пар -->
    <Button
        android:id="@+id/pairsCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/oval_shape"
        android:clickable="false"
        android:elevation="5dp"
        android:focusable="false"
        android:padding="1dp"
        android:textColor="#ffffff"
        android:textSize="25sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="10" />

    <!-- Выбор размера поля: подписи и раскладка задаются из кода по ориентации/размеру экрана -->
    <LinearLayout
        android:id="@+id/sizeSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/sizeSmall"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/memory_size_chip"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#263238"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="2×3" />

        <TextView
            android:id="@+id/sizeLarge"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/memory_size_chip"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#263238"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="3×4" />
        <TextView
            android:id="@+id/sizeExtra"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/memory_size_chip"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#263238"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="5×6" />
    </LinearLayout>

    <!-- Игровое поле: карточки создаются и расставляются из кода под размер области -->
    <FrameLayout
        android:id="@+id/memoryBoard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/sizeSelector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pairsCounter" />

</androidx.constraintlayout.widget.ConstraintLayout>
