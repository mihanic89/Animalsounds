<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Счётчики правильных/неправильных ответов -->
    <LinearLayout
        android:id="@+id/downLayoutText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/wrongCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:background="@drawable/oval_shape_red"
            android:clickable="false"
            android:elevation="5dp"
            android:focusable="false"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:textColor="#ffffff"
            android:textSize="25sp"
            app:autoSizeTextType="uniform"
            tools:text="10" />

        <Button
            android:id="@+id/correctCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:background="@drawable/oval_shape"
            android:clickable="false"
            android:elevation="5dp"
            android:focusable="false"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:textColor="#ffffff"
            android:textSize="25sp"
            app:autoSizeTextType="uniform"
            tools:text="10" />

    </LinearLayout>

    <!-- Фоновая картинка целиком (перекрывается сеткой imageGame0-3, как в оригинале) -->
    <ImageButton
        android:id="@+id/imageFull"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@null"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/downLayoutText"
        app:layout_constraintBottom_toTopOf="@id/downLayout" />

    <!-- Сетка 2x2 картинок для выбора -->
    <LinearLayout
        android:id="@+id/two"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:weightSum="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/downLayoutText"
        app:layout_constraintBottom_toTopOf="@id/downLayout">

        <LinearLayout
            android:id="@+id/up"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <ImageButton
                android:id="@+id/imageGame0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/image_margin"
                android:adjustViewBounds="true"
                android:background="@null"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/a5hd" />

            <ImageButton
                android:id="@+id/imageGame1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/image_margin"
                android:adjustViewBounds="true"
                android:background="@null"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/w8hd" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/down"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <ImageButton
                android:id="@+id/imageGame2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/image_margin"
                android:adjustViewBounds="true"
                android:background="@null"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/a7hd" />

            <ImageButton
                android:id="@+id/imageGame3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/image_margin"
                android:adjustViewBounds="true"
                android:background="@null"
                android:elevation="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/w8hd" />

        </LinearLayout>

    </LinearLayout>

    <!-- Нижняя панель: название / далее -->
    <LinearLayout
        android:id="@+id/downLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/buttonName"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:layout_weight="7"
            android:background="@drawable/oval_shape"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:textColor="#ffffff"
            android:textSize="25sp"
            app:autoSizeTextType="uniform"
            tools:text="Animal" />

        <ImageButton
            android:id="@+id/buttonNext"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:layout_weight="2"
            android:background="@drawable/oval_shape"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            app:srcCompat="@android:drawable/ic_media_next" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>